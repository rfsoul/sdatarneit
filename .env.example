# Private persistent storage, outside dist. Defaults to the repository enquiries/ folder.
# The BTower systemd unit sets this explicitly; Docker uses its named volume.
ENQUIRIES_DIR=/home/al/Git/sdatarneit/enquiries
ALLOWED_ORIGINS=https://sdatarneit.au
# Only true if traffic can arrive solely through the trusted Cloudflare Tunnel.
TRUST_PROXY=false
PORT=8085
HOST=127.0.0.1
